# Copy to .env.dev (gitignored) and fill in. Read by scripts/dev.sh.
# LAN address of this machine (ip -4 addr); never 0.0.0.0, never a public address.
WORT_DEV_HOST=192.0.2.10
# 8455/8456 are the deployed web and sync ports (compose.yaml); pick a different one.
WORT_DEV_PORT=8458
# TLS cert and key, kept outside the repo (DEPLOY.md §1); the cert's SAN must contain WORT_DEV_HOST.
WORT_DEV_TLS_CERT=/home/me/.config/wort/certs/wort.crt
WORT_DEV_TLS_KEY=/home/me/.config/wort/certs/wort.key
# Dev only (DECISIONS D00g): the CLI user.db on this machine; enables "Gesuchte laden" on Wörter. Never on the server.
WORT_CLI_DB=/home/me/.local/share/wort/user.db
